# StockFlow Backend — Environment Variables
# Copy this file to .env and fill in the real values.
# Never commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_use_a_long_random_string_in_production
JWT_EXPIRES_IN=15d

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
# Local dev:       amqp://localhost:5672
# Docker Compose:  amqp://rabbitmq:5672   (service name as hostname)
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE_MOVEMENTS=queue_designed_name

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL del frontend en producción (ej: https://tu-app.vercel.app)
FRONTEND_URL=https://tu-app.vercel.app
